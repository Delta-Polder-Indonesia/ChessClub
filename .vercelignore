# Berkas yang TIDAK perlu diunggah ke Vercel.
# FULL VERCEL: frontend statis di-build dari src/ + public/, dan backend
# berjalan sebagai Serverless Function dari api/[...jalur].js yang
# mengimpor server/src/index.js. Karena itu server/ TIDAK boleh diabaikan.

# Dependensi & hasil build (Vercel membangunnya sendiri)
node_modules/
dist/
.vercel/

# Skrip & uji — tidak dipakai frontend maupun function
scripts/
tests/
playwright.config.js
playwright-report/
test-results/

# Berkas CI / sistem
.github/

# Berkas data backend.
# data/*.json (anggota, turnamen, berita, pengumuman, dll) justru IKUT
# di-deploy: ia menjadi "data benih" yang disalin ke /tmp/kci-data saat
# function mulai (lihat api/[...jalur].js), sehingga data yang di-commit ke
# Git tampil permanen di Vercel.
# Pola diawali "/" agar hanya menyentuh folder data di root, bukan
# src/data/ yang berisi data panduan frontend.
#
# Yang TETAP diabaikan: data pribadi & hasil tulis saat runtime (tidak
# pernah di-commit; lihat .gitignore) - jangan sampai terbawa ke deployment.
/data/rahasia/
/data/pesan.json
/data/riwayat-masuk.json

# Dokumen & catatan pengembangan
*.md
doc/
puzzel.md
prompt.md
.env
.env.*
!.env.contoh

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
