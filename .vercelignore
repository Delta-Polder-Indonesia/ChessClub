# Berkas yang TIDAK perlu diunggah ke Vercel.
# FULL VERCEL: frontend statis di-build dari src/ + public/, dan backend
# berjalan sebagai Serverless Function dari api/[...jalur].js yang
# mengimpor server/src/index.js. Karena itu server/ TIDAK boleh diabaikan.

# Dependensi & hasil build (Vercel membangunnya sendiri)
node_modules/
dist/
.vercel/

# Skrip & uji — tidak dipakai frontend maupun function
scripts/
tests/
playwright.config.js
playwright-report/
test-results/

# Berkas CI / sistem
.github/

# Berkas data backend (ditulis server saat berjalan; di Vercel data disimpan
# di /tmp/kci-data, bukan di bundle deployment)
# Pola diawali "/" agar HANYA folder data di root yang diabaikan,
# bukan src/data/ yang berisi data panduan frontend.
/data/

# Dokumen & catatan pengembangan
*.md
doc/
puzzel.md
prompt.md
.env
.env.*
!.env.contoh

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
