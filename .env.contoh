# Salin menjadi .env lalu isi nilainya.
# JANGAN commit berkas .env — sudah diabaikan oleh .gitignore.

# Kata rahasia untuk hashing identitas anggota.
# WAJIB diisi di produksi. Server menerima minimal 16 karakter; gunakan 32+ karakter acak.
# JANGAN PERNAH diganti setelah ada data — semua hash lama jadi tak cocok.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KCI_PEPPER=

# Login pengurus metode umum (username + password).
# Gunakan kredensial kuat milik deployment; contoh ini sengaja kosong.
KCI_ADMIN_USER=
KCI_ADMIN_PASSWORD=

# Rahasia tanda tangan sesi JWT pengurus. WAJIB di produksi. Server menerima
# minimal 24 karakter; gunakan 32+ karakter acak dan bedakan dari rahasia lain.
KCI_JWT_SECRET=

# Token untuk endpoint pengurus (/api/pengurus/*) — metode lama/legacy.
# Masih didukung sebagai password alternatif bila diisi, tetapi login utama
# dashboard /pengurus memakai KCI_ADMIN_USER + KCI_ADMIN_PASSWORD.
# Opsional bila KCI_ADMIN_PASSWORD sudah kuat.
KCI_TOKEN_ADMIN=

# Alamat situs Vercel yang boleh memanggil API, dipisah koma, tanpa trailing slash.
# Contoh produksi: https://chess-club-weld.vercel.app
# Contoh lokal: http://localhost:5173
KCI_ASAL_DIIZINKAN=

# Berapa banyak proxy tepercaya yang berada di DEPAN server
# (Cloudflare, Nginx, load balancer). Bawaan 0 = server
# terhubung langsung ke klien, dan header X-Forwarded-For diabaikan
# agar tidak bisa dipakai memalsukan IP untuk melewati pembatasan laju.
# Naikkan menjadi 1 (atau N sesuai jumlah proxy) bila server berada di
# belakang proxy yang menambahkan header X-Forwarded-For.
KCI_JUMLAH_PROXY=0

# Opsional
PORT=8787
NODE_ENV=production
# Log JSON ringkas per request (tanpa body/token/IP); cocok untuk journalctl.
KCI_LOG_PERMINTAAN=1

# Catatan: server dianggap MODE PRODUKSI bila NODE_ENV=production ATAU
# KCI_ASAL_DIIZINKAN diisi. Dalam mode itu wajib diisi: KCI_PEPPER >= 16 karakter,
# KCI_ADMIN_PASSWORD >= 12 karakter dan bukan bawaan admin123, KCI_JWT_SECRET
# >= 24 karakter, serta KCI_TOKEN_ADMIN >= 24 karakter bila dipakai (legacy).
# Kurang dari itu server menolak jalan dan keluar dengan daftar masalahnya.

# --- Sumber daftar anggota Chess.com ---
# URL-ID dari https://www.chess.com/club/blunder-skuad (bukan URL lengkap).
# Roster publiknya menjadi sumber daftar anggota yang tampil di situs.
KCI_CHESS_KLUB=blunder-skuad
# Chess.com memperbarui roster klub maksimal tiap 12 jam.
KCI_CHESS_KLUB_CACHE=43200
# Cache profil/rating anggota agar satu kunjungan tidak membanjiri API.
KCI_CHESS_KLUB_PROFILE_CACHE=3600

# --- Login dengan akun Chess.com (OAuth 2.0) ---
# Ajukan permohonan client_id di: https://forms.gle/7Ai8UZCJMZkCVvxn9
# Selama kosong, sistem otomatis memakai jalur cadangan (kode di profil).
# URI kembali harus PERSIS sama dengan yang didaftarkan ke Chess.com:
#   https://chess-club-weld.vercel.app/api/auth/chess/kembali
KCI_CHESS_CLIENT_ID=
KCI_CHESS_CLIENT_SECRET=
KCI_CHESS_REDIRECT_URI=https://chess-club-weld.vercel.app/api/auth/chess/kembali

# Wajibkan bukti kepemilikan akun? off | opsional | wajib
# Nilai tidak dikenal (mis. "Wajibb") TIDAK menjatuhkan mode ke "off": server
# memakai "opsional" + peringatan di log, supaya salah ketik tidak diam-diam
# membuka kunci semua akun. Default tidak diubah.
KCI_WAJIB_VERIFIKASI=opsional

# Umur tiket verifikasi (detik). Tiket = token HMAC tanpa keadaan, jadi valid
# di instance mana pun selama belum kedaluwarsa dan belum dipakai.
# KCI_TIKET_UMUR_DETIK=1800

# Jalur cadangan "kode di profil": umur kode tantangan, jeda minimum antar
# pemeriksaan, dan batas percobaan. Semua disimpan lewat lapisan penyimpanan
# data yang sama seperti berkas anggota (Supabase kci_storage bila dipasang),
# sehingga tantangan tetap terlihat oleh instance berikutnya.
# KCI_TANTANGAN_UMUR_DETIK=1800
# KCI_TANTANGAN_JEDA_DETIK=5
# KCI_TANTANGAN_MAKS_PERCOBAAN=40

# --- Frontend (hanya dipakai saat build; tidak dibaca server) ---
# Alamat situs publik (canonical, og:url, sitemap, robots.txt, JSON-LD).
# Di Vercel, bila KOSONG, build otomatis memakai VERCEL_PROJECT_PRODUCTION_URL.
# Isi eksplisit agar tetap benar di semua skenario deploy, mis.
#   VITE_SITE_URL=https://chess-club-weld.vercel.app
# atau domain kustom:
#   VITE_SITE_URL=https://komunitascatur.or.id
VITE_SITE_URL=

# Alamat backend yang dipanggil frontend. KOSONG = URL relatif "/api/…"
# yang diteruskan oleh rewrite Vercel. Untuk FULL VERCEL biarkan kosong.
# Isi hanya bila API sengaja berada di domain berbeda.
VITE_API_DASAR=

# Cadangan roster frontend statis. Samakan nilainya dengan KCI_CHESS_KLUB
# bila klub diganti; hanya URL-ID Chess.com yang boleh digunakan.
VITE_CHESS_KLUB=blunder-skuad

# --- Penyimpanan persisten (Supabase / PostgreSQL) untuk FULL VERCEL ---
# PENTING: Tanpa ini, data yang ditulis di Vercel (pendaftaran, turnamen,
# berita, pesan, admin, jejak audit) disimpan di /tmp yang hilang saat
# cold start / redeploy — itulah penyebab "data tidak tersimpan".
#
# Langkah:
#   1. Buat tabel: jalankan db/supabase-schema.sql di SQL Editor Supabase.
#   2. Isi dua variabel di bawah (Vercel → Settings → Environment Variables),
#      lalu Redeploy. Format integrasi Vercel+Supabase otomatis menyuntikkan
#      SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY.
#
# Kunci SERVICE ROLE melewati RLS dan digunakan backend untuk baca & tulis.
# JANGAN gunakan anon key untuk menulis data pribadi di produksi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (opsional) dipakai bila SERVICE_ROLE kosong; butuh kebijakan RLS.
SUPABASE_ANON_KEY=

# --- E-Book: storage privat + proxy bertiket ---
# Jalankan `npm run ebook:unggah` (baca PANDUAN-EBOOK-STORAGE.md) memakai
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY di atas. Skrip mengunggah
# public/ebooks/*.pdf ke bucket privat ini. Credential hanya dibaca backend;
# frontend selalu memakai /api/ebook-preview setelah redemption.
KCI_EBOOK_PRIVATE_BUCKET=ebooks-private
# Alternatif storage privat non-Supabase:
# KCI_EBOOK_PRIVATE_BASE=https://storage-internal.example/ebooks
# KCI_EBOOK_PRIVATE_TOKEN=
