# Salin menjadi .env lalu isi nilainya.
# JANGAN commit berkas .env — sudah diabaikan oleh .gitignore.

# Kata rahasia untuk hashing identitas anggota.
# WAJIB diisi di produksi, minimal 16 karakter.
# JANGAN PERNAH diganti setelah ada data — semua hash lama jadi tak cocok.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KCI_PEPPER=

# Token untuk endpoint pengurus (/api/pengurus/*).
# WAJIB diisi di produksi, minimal 24 karakter.
KCI_TOKEN_ADMIN=

# Alamat situs yang boleh memanggil API, dipisah koma.
# Contoh: https://delta-polder-indonesia.github.io,http://localhost:5173
KCI_ASAL_DIIZINKAN=

# Berapa banyak proxy tepercaya yang berada di DEPAN server
# (Cloudflare, Nginx, Render, load balancer). Bawaan 0 = server
# terhubung langsung ke klien, dan header X-Forwarded-For diabaikan
# agar tidak bisa dipakai memalsukan IP untuk melewati pembatasan laju.
# Naikkan menjadi 1 (atau N sesuai jumlah proxy) bila server berada di
# belakang proxy yang menambahkan header X-Forwarded-For.
KCI_JUMLAH_PROXY=0

# Opsional
PORT=8787
NODE_ENV=production
# Log JSON ringkas per request (tanpa body/token/IP); cocok untuk journalctl.
KCI_LOG_PERMINTAAN=1

# Catatan: server dianggap MODE PRODUKSI bila NODE_ENV=production ATAU
# KCI_ASAL_DIIZINKAN diisi. Dalam mode itu server menolak start bila
# KCI_PEPPER / KCI_TOKEN_ADMIN kosong (mencegah pepper pengembangan yang
# ada di source code terpakai di server publik).

# --- Sumber daftar anggota Chess.com ---
# URL-ID dari https://www.chess.com/club/blunder-skuad (bukan URL lengkap).
# Roster publiknya menjadi sumber daftar anggota yang tampil di situs.
KCI_CHESS_KLUB=blunder-skuad
# Chess.com memperbarui roster klub maksimal tiap 12 jam.
KCI_CHESS_KLUB_CACHE=43200
# Cache profil/rating anggota agar satu kunjungan tidak membanjiri API.
KCI_CHESS_KLUB_PROFILE_CACHE=3600

# --- Login dengan akun Chess.com (OAuth 2.0) ---
# Ajukan permohonan client_id di: https://forms.gle/7Ai8UZCJMZkCVvxn9
# Selama kosong, sistem otomatis memakai jalur cadangan (kode di profil).
KCI_CHESS_CLIENT_ID=
KCI_CHESS_CLIENT_SECRET=
KCI_CHESS_REDIRECT_URI=https://kci-api.onrender.com/api/auth/chess/kembali

# Wajibkan bukti kepemilikan akun? off | opsional | wajib
KCI_WAJIB_VERIFIKASI=opsional

# --- Frontend (hanya dipakai saat build; tidak dibaca server) ---
# Alamat backend yang dipanggil frontend. KOSONG = URL relatif "/api/…"
# (diteruskan proxy Vite/Netlify/Nginx). Isi hanya bila frontend dan
# backend di domain berbeda tanpa proxy, mis. frontend di GitHub Pages:
#   VITE_API_DASAR=https://kci-api.onrender.com
# Workflow deploy menyetelnya otomatis (bawaan di atas; override lewat
# repository variable KCI_API_URL).
VITE_API_DASAR=

# Cadangan roster frontend statis. Samakan nilainya dengan KCI_CHESS_KLUB
# bila klub diganti; hanya URL-ID Chess.com yang boleh digunakan.
VITE_CHESS_KLUB=blunder-skuad
