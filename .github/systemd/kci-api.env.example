# Salin sebagai /etc/kci/kci-api.env, isi nilai asli, lalu chmod 640 root:kci.
NODE_ENV=production
PORT=8787
KCI_PEPPER=GANTI_DENGAN_PEPPER_ACAK_MINIMAL_16_KARAKTER
KCI_ADMIN_USER=admin
KCI_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# Opsional legacy:
# KCI_TOKEN_ADMIN=GANTI_DENGAN_TOKEN_ACAK_MINIMAL_24_KARAKTER
KCI_ASAL_DIIZINKAN=https://domain-frontend-anda.id
KCI_JUMLAH_PROXY=1
KCI_CHESS_KLUB=blunder-skuad
KCI_DIR_DATA=/var/lib/kci
KCI_DIR_BACKUP=/var/backups/kci
KCI_RETENSI_BACKUP=14
