{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "timeout": {
          "catalog": 30000
        },
        "protocol": "legacy"
      }
    }
  },
  "plugins": [
    "./.opencode/plugins/design-audit",
    "opencode-acme-plugin@1.2.0"
  ],
  "permissions": [
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
